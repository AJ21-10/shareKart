PORT=5000

# Generate a unique secret with: openssl rand -base64 48
JWT_SECRET=

# PostgreSQL connection string or individual parameters below.
DATABASE_URL=
# PGUSER=postgres
# PGHOST=localhost
# PGPASSWORD=
# PGDATABASE=sharekart_db
# PGPORT=5432
# PGSSL=false

# UIDAI e-KYC trusted certificates
UIDAI_TRUSTED_CERTS_DIR=./src/certificates/trusted_ca

# Phone.Email credentials. Keep API keys server-side.
PHONE_EMAIL_API_KEY=
PHONE_EMAIL_CLIENT_ID=
# CLIENT_ID is also accepted by the server for compatibility.
CLIENT_ID=

# Supabase settings. Never expose a service-role key in client-side VITE_ variables.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
